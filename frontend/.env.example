# Copy to frontend/.env for local development (ignored by git).
# On Vercel, set VITE_API_URL in Project Settings -> Environment Variables.
#
# Base URL of the Spring Boot backend, WITHOUT /api and without a trailing slash.
#   Local:      http://localhost:8080
#   Production: https://your-backend-name.onrender.com
VITE_API_URL=http://localhost:8080
