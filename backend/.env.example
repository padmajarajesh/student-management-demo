# Copy this file to backend/.env for local development (it is loaded
# automatically and ignored by git). On Render, set these as environment
# variables in the dashboard instead. Placeholder values only.

# --- Local PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/student_management
DB_USERNAME=postgres
DB_PASSWORD=your-local-postgres-password

# --- Neon PostgreSQL (production example) ---
# DB_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# DB_USERNAME=neondb_owner
# DB_PASSWORD=your-neon-password

# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Exact frontend origin(s), comma-separated, no trailing slash
FRONTEND_URL=http://localhost:5173

# Server port (Render sets this automatically)
PORT=8080

# Optional overrides
# SPRING_PROFILES_ACTIVE=prod
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=Lax
# DB_POOL_SIZE=5
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=7
